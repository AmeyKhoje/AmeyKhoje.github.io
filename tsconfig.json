{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "lib": ["ESNext", "DOM"],

    "jsx": "react-jsx",

    "types": ["node", "vite/client"],

    "strict": true,
    "skipLibCheck": true,

    "paths": {
      "src/*": ["./src/*"],
      "components/*": ["./src/components/*"],
      "assets/*": ["./src/assets/*"]
    },

    "noEmit": true
  },

  "include": ["src", "vite.config.ts"]
}